<Application x:Class="AtolGenerator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:AtolGenerator.Views.Converters"
             StartupUri="Views/MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
      <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
      <cv:NonZeroToBoolConverter x:Key="NonZeroBool"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
