<Window x:Class="AtolGenerator.Views.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:AtolGenerator.Views.Converters"
        Title="Предпросмотр чека"
        Icon="/Resources/app.ico"
        Width="420" Height="720"
        MinWidth="360" MinHeight="420"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
  <Window.Resources>
    <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
    <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
  </Window.Resources>

  <Border Margin="12" Padding="14"
          Background="{DynamicResource BrushSurface1}"
          BorderBrush="{DynamicResource BrushBorder}"
          BorderThickness="1" CornerRadius="10">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
        <Border Width="3" Height="13" Background="{DynamicResource BrushAccent2}"
                CornerRadius="2" Margin="0,0,7,0" VerticalAlignment="Center"/>
        <TextBlock Text="ПРЕДПРОСМОТР ЧЕКА" Style="{StaticResource SectionTitle}" Margin="0"/>
      </StackPanel>

      <TextBlock DockPanel.Dock="Top"
                 Text="Выберите чек в списке результатов"
                 FontSize="13" Foreground="{DynamicResource BrushText3}"
                 HorizontalAlignment="Center" Margin="0,48,0,0"
                 Visibility="{Binding HasReceiptPreview, Converter={StaticResource InvBoolVis}}"/>

      <Border Background="{DynamicResource BrushSurface2}"
              BorderBrush="{DynamicResource BrushBorder}"
              BorderThickness="1" CornerRadius="7" Padding="14"
              Visibility="{Binding HasReceiptPreview, Converter={StaticResource BoolVis}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding SelectedReceiptPreview}"
                     FontFamily="Courier New" FontSize="12.5"
                     Foreground="{DynamicResource BrushText2}"
                     TextWrapping="NoWrap" LineHeight="20"/>
        </ScrollViewer>
      </Border>
    </DockPanel>
  </Border>
</Window>
